# Gagesite on a public address, behind a password (compose profile "public", docs/DEPLOY.md).
#
# Gagesite itself stays on 127.0.0.1 (web 3000, backend 8001, previews 3100-3119). Caddy answers on
# two public ports and lets a request through only when the backend's /auth/check accepts its
# session cookie (backend/app/access.py); otherwise the browser gets the sign-in page.
#   PUBLIC_PORT  (9021): Gagesite. /api/* goes to the backend, everything else to the web app.
#   PREVIEW_PORT (9022): the website previews. /__preview/<port>/<path> picks the preview (a cookie
#                        remembers it), so one browser shows one preview at a time.
#   API_PORT     (9023): the previews' own APIs (4100-4119) and their docs, picked the same way with
#                        /__api/<port>/<path>.
{
	admin off
	auto_https off
	servers {
		# Cloudflare tunnels (compose profile "tunnel") reach Caddy from this server itself: keep the
		# visitor's address and https from their headers (the sign-in pauses per visitor address).
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

(signed_in) {
	forward_auth 127.0.0.1:8001 {
		uri /auth/check
	}
}

:{$PUBLIC_PORT:9021} {
	encode gzip
	handle /auth/* {
		reverse_proxy 127.0.0.1:8001
	}
	handle /api/* {
		import signed_in
		# Live run updates are a stream: pass them on at once.
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}
	handle {
		import signed_in
		reverse_proxy 127.0.0.1:3000
	}
}

:{$PREVIEW_PORT:9022} {
	# The tunnel's preview link signs itself in with a ticket from Gagesite (backend/app/access.py).
	handle /__gagesite/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		import signed_in

		# Through the tunnel (https) the preview link sits in Gagesite's frame as a third-party
		# site: phone browsers keep only partitioned, SameSite=None cookies there.
		@open_tls {
			path_regexp open ^/__preview/(31[01][0-9])(/.*)$
			header X-Forwarded-Proto https
		}
		handle @open_tls {
			header Set-Cookie "gagesite_preview={re.open.1}; Path=/; HttpOnly; Secure; SameSite=None; Partitioned"
			redir "{re.open.2}?{query}" 302
		}
		@open path_regexp open ^/__preview/(31[01][0-9])(/.*)$
		handle @open {
			header Set-Cookie "gagesite_preview={re.open.1}; Path=/; SameSite=Lax; HttpOnly"
			redir "{re.open.2}?{query}" 302
		}
		@bare path_regexp bare ^/__preview/(31[01][0-9])$
		handle @bare {
			redir /__preview/{re.bare.1}/ 302
		}

		handle {
			map {cookie.gagesite_preview} {preview_upstream} {
				~^(31[01][0-9])$ "127.0.0.1:${1}"
				default "127.0.0.1:3100"
			}
			reverse_proxy {preview_upstream} {
				header_up Host localhost
				flush_interval -1
			}
		}
	}
}

:{$API_PORT:9023} {
	# Opened in its own tab (the API docs), so a plain session cookie is enough here; the tunnel's
	# API link signs itself in with a ticket like the preview link.
	handle /__gagesite/* {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		import signed_in

		@open path_regexp open ^/__api/(41[01][0-9])(/.*)$
		handle @open {
			header Set-Cookie "gagesite_api={re.open.1}; Path=/; SameSite=Lax; HttpOnly"
			redir "{re.open.2}?{query}" 302
		}
		@bare path_regexp bare ^/__api/(41[01][0-9])$
		handle @bare {
			redir /__api/{re.bare.1}/ 302
		}

		handle {
			map {cookie.gagesite_api} {api_upstream} {
				~^(41[01][0-9])$ "127.0.0.1:${1}"
				default "127.0.0.1:4100"
			}
			reverse_proxy {api_upstream} {
				flush_interval -1
			}
		}
	}
}
