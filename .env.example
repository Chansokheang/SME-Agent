# Settings for running Gagesite with Docker (compose.yml). Copy to .env on the server.
# Running the backend directly on your machine needs none of this: it uses your normal `claude` login.

# Claude: the long-lived token for your subscription. Create it with `claude setup-token` (on any
# computer signed in to that account) and paste it here. It becomes "This computer's login" in
# Gagesite. You can also leave it empty and add accounts in Gagesite instead.
CLAUDE_CODE_OAUTH_TOKEN=

# How many AI runs may work at once on this account.
MAX_CONCURRENT_RUNS=3

# Your server user's ids, so the files in ./data are yours: run `id -u` and `getent group docker`.
GAGESITE_UID=1000
DOCKER_GID=998

# Where Gagesite listens. 127.0.0.1 = the server itself only (open it through scripts/tunnel.ps1).
# Gagesite has no sign-in: don't use 0.0.0.0 on a server the internet can reach.
BIND_HOST=127.0.0.1

# The backend's address as your browser sees it (baked into the web app when it's built).
PUBLIC_API_URL=http://localhost:8001

# Opening Gagesite from the internet, behind a password (see docs/DEPLOY.md, "Public address").
# Leave COMPOSE_PROFILES empty to use the SSH tunnel only.
COMPOSE_PROFILES=
GAGESITE_PASSWORD=
PUBLIC_PORT=9021
PREVIEW_PORT=9022
